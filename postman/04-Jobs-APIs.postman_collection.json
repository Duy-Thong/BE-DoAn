    {
      "name": "Public Job APIs",
      "item": [
        {
          "name": "List Jobs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Parse response",
                  "const response = pm.response.json();",
                  "",
                  "// Test status code",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Test response structure",
                  "pm.test(\"Response has success field\", function () {",
                  "    pm.expect(response).to.have.property('success', true);",
                  "});",
                  "",
                  "pm.test(\"Response has data array\", function () {",
                  "    pm.expect(response).to.have.property('data');",
                  "    pm.expect(response.data).to.be.an('array');",
                  "});",
                  "",
                  "// Test pagination",
                  "pm.test(\"Response has pagination info\", function () {",
                  "    pm.expect(response).to.have.property('meta');",
                  "    pm.expect(response.meta).to.have.property('total');",
                  "    pm.expect(response.meta).to.have.property('page');",
                  "    pm.expect(response.meta).to.have.property('limit');",
                  "});",
                  "",
                  "// Save first job ID for testing",
                  "if (response.success && response.data && response.data.length > 0) {",
                  "    const firstJob = response.data[0];",
                  "    pm.environment.set(\"jobId\", firstJob.id);",
                  "    console.log(\"✓ Saved jobId:\", firstJob.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/jobs?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true,
                  "description": "Search by job title"
                },
                {
                  "key": "location",
                  "value": "",
                  "disabled": true,
                  "description": "Filter by location"
                },
                {
                  "key": "employmentType",
                  "value": "",
                  "disabled": true,
                  "description": "FULL_TIME, PART_TIME, CONTRACT, INTERNSHIP"
                },
                {
                  "key": "experienceLevel",
                  "value": "",
                  "disabled": true,
                  "description": "ENTRY, JUNIOR, MIDDLE, SENIOR, LEAD"
                },
                {
                  "key": "status",
                  "value": "",
                  "disabled": true,
                  "description": "OPEN, CLOSED, DRAFT"
                }
              ]
            },
            "description": "Get list of jobs with pagination and filters. Public access."
          },
          "response": []
        },
