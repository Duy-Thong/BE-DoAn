    {
      "name": "Profile Management",
      "item": [
        {
          "name": "Get My Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Parse response",
                  "const response = pm.response.json();",
                  "",
                  "// Test status code",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Test response structure",
                  "pm.test(\"Response has success field\", function () {",
                  "    pm.expect(response).to.have.property('success', true);",
                  "});",
                  "",
                  "pm.test(\"Response has data object\", function () {",
                  "    pm.expect(response).to.have.property('data');",
                  "    pm.expect(response.data).to.be.an('object');",
                  "});",
                  "",
                  "// Test user data",
                  "pm.test(\"User data has required fields\", function () {",
                  "    pm.expect(response.data).to.have.property('id');",
                  "    pm.expect(response.data).to.have.property('email');",
                  "    pm.expect(response.data).to.have.property('role');",
                  "});",
                  "",
                  "// Save user data",
                  "if (response.success && response.data) {",
                  "    pm.environment.set(\"userId\", response.data.id);",
                  "    pm.environment.set(\"userEmail\", response.data.email);",
                  "    pm.environment.set(\"userRole\", response.data.role);",
                  "    console.log(\"✓ Saved userId:\", response.data.id);",
                  "    console.log(\"✓ Saved userEmail:\", response.data.email);",
                  "    console.log(\"✓ Saved userRole:\", response.data.role);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            },
            "description": "Get current authenticated user's profile."
          },
          "response": []
        },
