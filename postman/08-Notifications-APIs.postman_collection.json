    {
      "name": "Notification Management",
      "item": [
        {
          "name": "Create Notification",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Parse response",
                  "const response = pm.response.json();",
                  "",
                  "// Test status code",
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "// Test response",
                  "pm.test(\"Response has success field\", function () {",
                  "    pm.expect(response).to.have.property('success', true);",
                  "});",
                  "",
                  "pm.test(\"Response has created notification data\", function () {",
                  "    pm.expect(response).to.have.property('data');",
                  "    pm.expect(response.data).to.have.property('id');",
                  "    pm.expect(response.data).to.have.property('title');",
                  "    pm.expect(response.data).to.have.property('message');",
                  "    pm.expect(response.data).to.have.property('type');",
                  "});",
                  "",
                  "// Save created notification ID",
                  "if (response.success && response.data) {",
                  "    pm.environment.set(\"notificationId\", response.data.id);",
                  "    console.log(\"✓ Saved notificationId:\", response.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Ứng tuyển mới\",\n  \"message\": \"Bạn có một ứng tuyển mới cho vị trí Senior Backend Developer\",\n  \"type\": \"JOB_APPLICATION\",\n  \"userId\": \"{{userId}}\",\n  \"isRead\": false,\n  \"data\": {\n    \"relatedType\": \"APPLICATION\",\n    \"relatedId\": \"{{applicationId}}\",\n    \"jobTitle\": \"Senior Backend Developer\",\n    \"companyName\": \"Tech Company\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"]
            },
            "description": "Create a new notification (typically called by system)."
          },
          "response": []
        },
        {
          "name": "Get All Notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Parse response",
                  "const response = pm.response.json();",
                  "",
                  "// Test status code",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Test response structure",
                  "pm.test(\"Response has success field\", function () {",
                  "    pm.expect(response).to.have.property('success', true);",
                  "});",
                  "",
                  "pm.test(\"Response has data array\", function () {",
                  "    pm.expect(response).to.have.property('data');",
                  "    pm.expect(response.data).to.be.an('array');",
                  "});",
                  "",
                  "// Test pagination",
                  "pm.test(\"Response has pagination info\", function () {",
                  "    pm.expect(response).to.have.property('pagination');",
                  "    pm.expect(response.pagination).to.have.property('total');",
                  "    pm.expect(response.pagination).to.have.property('page');",
                  "    pm.expect(response.pagination).to.have.property('limit');",
                  "});",
                  "",
                  "// Save first notification ID for testing",
                  "if (response.success && response.data && response.data.length > 0) {",
                  "    const firstNotification = response.data[0];",
                  "    pm.environment.set(\"notificationId\", firstNotification.id);",
                  "    console.log(\"✓ Saved notificationId:\", firstNotification.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "type",
                  "value": "",
                  "disabled": true,
                  "description": "Filter by type: INFO, SUCCESS, WARNING, ERROR"
                },
                {
                  "key": "isRead",
                  "value": "",
                  "disabled": true,
                  "description": "Filter by read status: true or false"
                }
              ]
            },
            "description": "Get all notifications for the current user with pagination and filters."
          },
          "response": []
