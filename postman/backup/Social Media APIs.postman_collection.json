  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Log request name",
          "console.log('🚀 Executing:', pm.info.requestName);",
          "",
          "// Check required variables",
          "if (!pm.environment.get('accessToken')) {",
          "    console.warn('⚠️ accessToken is not set in environment');",
          "}",
          "if (!pm.environment.get('baseUrl')) {",
          "    console.warn('⚠️ baseUrl is not set in environment');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Common test for all requests",
          "pm.test('Response time is less than 5000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "pm.test('Response has success field', function () {",
          "    const jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.have.property('success');",
          "});",
          "",
          "// Test for successful responses",
          "if (pm.response.code >= 200 && pm.response.code < 300) {",
          "    pm.test('Response is successful', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData.success).to.be.true;",
          "    });",
          "    ",
          "    pm.test('Response has data field', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('data');",
          "    });",
          "}",
          "",
          "// Test for error responses",
          "if (pm.response.code >= 400) {",
          "    pm.test('Error response has message', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('error');",
          "    });",
          "}"
        ]
      }
    }
