    {
      "name": "Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Parse response",
              "const response = pm.response.json();",
              "",
              "// Test status code",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Test response",
              "pm.test(\"Response has success field\", function () {",
              "    pm.expect(response).to.have.property('success', true);",
              "});",
              "",
              "// Clear tokens on successful logout",
              "if (response.success) {",
              "    // Note: We don't clear tokens here to allow testing other endpoints",
              "    // Uncomment below to clear tokens after logout",
              "    // pm.environment.set(\"authToken\", \"\");",
              "    // pm.environment.set(\"refreshToken\", \"\");",
              "    console.log(\"✓ Logout successful (tokens not cleared for testing)\");",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{authToken}}",
              "type": "string"
            }
          ]
