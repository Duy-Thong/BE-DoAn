            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cvs/{{cvId}}/download?template=default&format=A4",
              "host": ["{{baseUrl}}"],
              "path": ["cvs", "{{cvId}}", "download"],
              "query": [
                {
                  "key": "template",
                  "value": "default",
                  "description": "Template slug/ID (e.g., 'default', 'modern', 'harvard', 'modern-professional')"
                },
                {
                  "key": "format",
                  "value": "A4",
                  "description": "Paper format: 'A4' or 'Letter' (default: A4)"
                }
              ]
            },
            "description": "Download CV as PDF file with specified template.\n\n**Query Parameters:**\n- `template`: Template slug or ID from database (e.g., 'modern-professional', 'creative-design') or legacy template name ('default', 'modern', 'harvard'). Default: 'default'\n- `format`: Paper format - 'A4' or 'Letter'. Default: 'A4'"
          },
          "response": []
