              "mode": "raw",
              "raw": "{\n  \"title\": \"Software Engineer CV\",\n  \"fullName\": \"Nguyen Van A\",\n  \"email\": \"nguyenvana@example.com\",\n  \"phoneNumber\": \"+84901234567\",\n  \"address\": \"123 Test Street, District 1, Ho Chi Minh City\",\n  \"summary\": \"Experienced software engineer with 5+ years in full-stack development.\",\n  \"workExperience\": [\n    {\n      \"title\": \"Senior Developer\",\n      \"company\": \"Tech Company\",\n      \"startDate\": \"2020-01-01T00:00:00.000Z\",\n      \"endDate\": null,\n      \"description\": \"Leading development of web applications\"\n    }\n  ],\n  \"education\": [\n    {\n      \"institution\": \"University of Technology\",\n      \"degree\": \"Bachelor of Computer Science\",\n      \"startDate\": \"2015-09-01T00:00:00.000Z\",\n      \"endDate\": \"2019-06-30T00:00:00.000Z\",\n      \"description\": \"Major: Computer Science | GPA: 3.8/4.0\"\n    }\n  ],\n  \"skills\": [\n    {\n      \"skillName\": \"JavaScript\",\n      \"level\": \"EXPERT\",\n      \"yearsOfExperience\": 5\n    },\n    {\n      \"skillName\": \"React\",\n      \"level\": \"ADVANCED\",\n      \"yearsOfExperience\": 4\n    },\n    {\n      \"skillName\": \"Node.js\",\n      \"level\": \"ADVANCED\",\n      \"yearsOfExperience\": 4\n    },\n    {\n      \"skillName\": \"TypeScript\",\n      \"level\": \"ADVANCED\",\n      \"yearsOfExperience\": 3\n    },\n    {\n      \"skillName\": \"PostgreSQL\",\n      \"level\": \"INTERMEDIATE\",\n      \"yearsOfExperience\": 3\n    }\n  ],\n  \"languages\": [\n    {\n      \"name\": \"Vietnamese\",\n      \"proficiency\": \"NATIVE\",\n      \"description\": \"Mother tongue\"\n    },\n    {\n      \"name\": \"English\",\n      \"proficiency\": \"PROFESSIONAL\",\n      \"description\": \"TOEIC 850\"\n    }\n  ],\n  \"certifications\": [\n    {\n      \"name\": \"AWS Certified Developer - Associate\",\n      \"issuer\": \"Amazon Web Services\",\n      \"acquiredAt\": \"2022-06-15T00:00:00.000Z\",\n      \"description\": \"Valid until June 2025\"\n    }\n  ],\n  \"projects\": [\n    {\n      \"name\": \"E-commerce Platform\",\n      \"description\": \"Built a full-stack e-commerce platform using React, Node.js, and PostgreSQL. Implemented features including product catalog, shopping cart, payment integration, and admin dashboard.\",\n      \"role\": \"Lead Developer\",\n      \"startDate\": \"2022-01-01T00:00:00.000Z\",\n      \"endDate\": \"2022-12-31T00:00:00.000Z\",\n      \"url\": \"https://github.com/example/ecommerce\"\n    },\n    {\n      \"name\": \"Job Portal System\",\n      \"description\": \"Developed a comprehensive job portal with features for both recruiters and candidates.\",\n      \"role\": \"Full-Stack Developer\",\n      \"startDate\": \"2023-01-01T00:00:00.000Z\",\n      \"endDate\": null\n    }\n  ]\n}"
            },
