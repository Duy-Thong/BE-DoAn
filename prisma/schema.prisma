
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Basic models for recruiting system
model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  fullName        String
  phoneNumber     String?
  dateOfBirth     DateTime?
  gender          Gender?
  nationality     String?
  role            UserRole       @default(CANDIDATE)
  isActive        Boolean        @default(true)
  isLocked        Boolean        @default(false)
  isEmailVerified Boolean        @default(false)
  lastLoginAt     DateTime?
  avatarUrl       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  // Core relationships only
  applications    Application[]
  savedJobs       SavedJob[]
  jobAlerts       JobAlert[]
  cvs             CV[]
  companyMembers  CompanyMember[]
  notifications   Notification[]
  
  // Virtual relationships (computed via ownerType + ownerId)
  socialMedia     SocialMedia[] @relation("UserSocialMedia")
  
  @@index([email])
  @@index([phoneNumber])
  @@index([role])
  @@index([isActive])
}

model Company {
  id              String   @id @default(cuid())
  name            String
  website         String?
  description     String?
  industry        String?
  companySize     CompanySize?
  foundedYear     Int?
  address         String?
  phone           String?
  email           String?
  logoUrl         String?
  isVerified      Boolean  @default(false)
  isActive        Boolean  @default(true)
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  jobs            Job[]
  members         CompanyMember[]
  
  // Virtual relationships (computed via ownerType + ownerId)
  socialMedia     SocialMedia[] @relation("CompanySocialMedia")
  
  @@index([name])
  @@index([industry])
  @@index([isActive, isVerified])
  @@index([createdAt])
}

model CompanyMember {
  id        String        @id @default(cuid())
  role      CompanyRole   @default(VIEWER)
  joinedAt  DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  company   Company       @relation(fields: [companyId], references: [id])
  companyId String
  invitedBy String?       // User ID who invited this member (no FK constraint)
  
  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

model CV {
  id              String   @id @default(cuid())
  title           String
  isMain          Boolean  @default(false)
  
  // Personal Information
  fullName        String
  email           String
  phoneNumber     String?
  dateOfBirth     DateTime?
  gender          Gender?
  nationality     String?
  address         String?
  avatarUrl       String?
  
  // Social Links handled by SocialMedia model
  
  // Current Position (like LinkedIn headline)
  currentPosition String?  // "Senior Developer at ABC Corp"
  
  // Professional Summary
  summary         String?
  objective       String?
  
  // Relationships to detailed information
  workExperience  WorkExperience[]
  education       Education[]
  languages       Language[]
  certifications  Certification[]
  projects        Project[]
  achievements    Achievement[]
  references      Reference[]
  skills          CVSkill[]
  activities      Activity[]
  
  // Virtual relationships (computed via ownerType + ownerId)
  socialMedia     SocialMedia[] @relation("CVSocialMedia")
  
  // Metadata
  version         Int      @default(1)
  lastGeneratedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  embedding       Float[]
  
  @@index([userId])
  @@index([isMain])
  @@index([createdAt])
}

model Job {
  id              String        @id @default(cuid())
  title           String
  description     String?
  location        String?
  type            JobType       @default(FULL_TIME)
  salary          String?
  embedding       Float[] 
  remoteWork      Boolean       @default(false)
  urgent          Boolean       @default(false)
  featured        Boolean       @default(false)
  isActive        Boolean       @default(true)
  isApproved      Boolean       @default(false)
  expiresAt       DateTime?
  viewCount       Int           @default(0)
  applicationCount Int          @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  company         Company       @relation(fields: [companyId], references: [id])
  companyId       String
  applications    Application[]
  views           JobView[]
  savedBy         SavedJob[]
  requirements    JobRequirement[]
  benefits        JobBenefit[]
  jobSkills       JobSkill[]
  
  @@index([companyId])
  @@index([isActive, isApproved])
  @@index([type])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([featured, isActive])
}

model Application {
  id              String   @id @default(cuid())
  status          AppStatus @default(PENDING)
  cv              CV?      @relation(fields: [cvId], references: [id])
  cvId            String?
  coverLetter     String?
  appliedAt       DateTime @default(now())
  availableFrom   DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  job             Job      @relation(fields: [jobId], references: [id])
  jobId           String
  
  @@index([userId, status])
  @@index([jobId, status])
  @@index([appliedAt])
}

// Profile model removed - information is already in CV and User models

// CV detail models removed - using structured JSON instead for better performance

model SocialMedia {
  id          String   @id @default(cuid())
  platform    String   // linkedin, facebook, twitter, instagram, github, blog, website, etc.
  url         String
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Polymorphic relationship
  ownerType   String   // "User", "Company", "CV"
  ownerId     String   // ID of the owner (user, company, or cv)
  
  // Virtual relationships (computed via ownerType + ownerId)
  user        User?    @relation("UserSocialMedia", fields: [ownerId], references: [id], map: "ownerId")
  company     Company? @relation("CompanySocialMedia", fields: [ownerId], references: [id], map: "ownerId")
  cv          CV?      @relation("CVSocialMedia", fields: [ownerId], references: [id], map: "ownerId")
  
  @@index([platform])
  @@index([ownerType, ownerId])
}

model SavedJob {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  job       Job      @relation(fields: [jobId], references: [id])
  jobId     String
  createdAt DateTime @default(now())
  
  @@unique([userId, jobId])
  @@index([userId])
  @@index([createdAt])
}

model JobAlert {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  keywords  String?
  location  String?
  type      JobType?
  createdAt DateTime @default(now())
}

model JobView {
  id        String   @id @default(cuid())
  job       Job      @relation(fields: [jobId], references: [id])
  jobId     String
  viewedAt  DateTime @default(now())
  
  @@index([jobId, viewedAt])
  @@index([viewedAt])
}

// JobRecommendation model removed - will use realtime search instead

// InternalNote model removed - not needed for core functionality

enum UserRole {
  ADMIN
  RECRUITER
  CANDIDATE
}

enum CompanyRole {
  OWNER
  MANAGER
  RECRUITER
  VIEWER
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum AppStatus {
  PENDING
  REVIEWING
  INTERVIEW
  OFFER
  REJECTED
}

// New Enums
enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum CompanySize {
  STARTUP      // 1-10
  SMALL        // 11-50
  MEDIUM       // 51-200
  LARGE        // 201-1000
  ENTERPRISE   // 1000+
}

enum ExperienceLevel {
  ENTRY        // 0-1 năm
  JUNIOR       // 1-3 năm
  MID          // 3-5 năm
  SENIOR       // 5-8 năm
  LEAD         // 8+ năm
}

enum NotificationType {
  JOB_APPLICATION
  JOB_APPROVED
  JOB_REJECTED
  INTERVIEW_SCHEDULED
  APPLICATION_STATUS_CHANGED
  NEW_JOB_MATCH
  COMPANY_VERIFIED
  SYSTEM_ANNOUNCEMENT
}

// InterviewStatus enum removed - Interview model removed

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum LanguageLevel {
  BASIC
  CONVERSATIONAL
  PROFESSIONAL
  NATIVE
}

// New Models
model Notification {
  id          String   @id @default(cuid())
  title       String
  message     String
  type        NotificationType
  isRead      Boolean  @default(false)
  data        Json?    // Dữ liệu bổ sung
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([type])
}



model WorkExperience {
  id          String   @id @default(cuid())
  title       String   // Job title/position
  company     String
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  cv          CV       @relation(fields: [cvId], references: [id])
  cvId        String
  
  @@index([cvId])
}

model Education {
  id          String   @id @default(cuid())
  institution String
  degree      String
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  cv          CV       @relation(fields: [cvId], references: [id])
  cvId        String
  
  @@index([cvId])
}

model Language {
  id          String   @id @default(cuid())
  name        String
  level       String?  // Basic, Intermediate, Advanced, Native
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  cv          CV       @relation(fields: [cvId], references: [id])
  cvId        String
  
  @@index([cvId])
}

model Certification {
  id          String   @id @default(cuid())
  name        String
  issuer      String?
  acquiredAt  DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  cv          CV       @relation(fields: [cvId], references: [id])
  cvId        String
  
  @@index([cvId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime?
  url         String?
  role        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  cv          CV       @relation(fields: [cvId], references: [id])
  cvId        String
  
  @@index([cvId])
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  description String?
  acquiredAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  cv          CV       @relation(fields: [cvId], references: [id])
  cvId        String
  
  @@index([cvId])
}

model Reference {
  id          String   @id @default(cuid())
  name        String
  position    String?
  company     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  cv          CV       @relation(fields: [cvId], references: [id])
  cvId        String
  
  @@index([cvId])
}

model Activity {
  id          String   @id @default(cuid())
  title       String   // "Volunteer Work", "Open Source Contribution", "Speaking", etc.
  organization String? // Organization or event name
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  cv          CV       @relation(fields: [cvId], references: [id])
  cvId        String
  
  @@index([cvId])
}

model CVSkill {
  id                  String   @id @default(cuid())
  skillName           String   // "JavaScript", "React", "Python", etc.
  level               SkillLevel
  yearsOfExperience   Int?
  description         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  cv                  CV       @relation(fields: [cvId], references: [id])
  cvId                String
  
  @@unique([cvId, skillName])
  @@index([cvId])
  @@index([skillName])
  @@index([level])
}

model JobRequirement {
  id          String   @id @default(cuid())
  title       String   // "Skills", "Experience", "Education", etc.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  job         Job      @relation(fields: [jobId], references: [id])
  jobId       String
  
  @@index([jobId])
}

model JobBenefit {
  id          String   @id @default(cuid())
  title       String   // "Health Insurance", "Remote Work", "Bonus", etc.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  job         Job      @relation(fields: [jobId], references: [id])
  jobId       String
  
  @@index([jobId])
}

model JobSkill {
  id          String   @id @default(cuid())
  skillName   String   // Direct skill name: "JavaScript", "React", "Python", etc.
  isRequired  Boolean  @default(true)
  job         Job      @relation(fields: [jobId], references: [id])
  jobId       String
  
  @@unique([jobId, skillName])
  @@index([jobId])
  @@index([skillName])
}

