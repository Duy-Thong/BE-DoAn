
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Basic models for recruiting system
model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  fullName        String
  phoneNumber     String?
  dateOfBirth     DateTime?
  gender          Gender?
  nationality     String?
  role            UserRole       @default(CANDIDATE)
  isActive        Boolean        @default(true)
  isLocked        Boolean        @default(false)
  lastLoginAt     DateTime?
  avatarUrl       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  // Company relationship (one-to-many)
  companyId       String?
  companyRole     CompanyRole?   @default(VIEWER)
  joinedAt        DateTime?      @default(now())
  
  // Relations (for querying, not stored in database)
  company         Company?       @relation(fields: [companyId], references: [id])
  
  // Core relationships only
  savedJobs       SavedJob[]
  cvs             CV[]
  notifications   Notification[]
  
  // Social media profiles (polymorphic relationship via ownerType + ownerId)
  
  @@index([email])
  @@index([phoneNumber])
  @@index([role])
  @@index([isActive])
  @@index([companyId])
}

// CANDIDATE -> ĐĂNG KÝ CTY ( PHÊ DUYỆT ) -> OWNER CTY , INVITE USER KHÁC VÀO CTY VÀ GẮN ROLE .
model Company {
  id              String   @id @default(cuid())
  name            String
  website         String?
  description     String?
  industry        String?
  companySize     CompanySize?
  foundedYear     Int?
  address         String?
  phone           String?
  email           String?
  logoUrl         String?
  isVerified      Boolean  @default(false)
  isActive        Boolean  @default(true)
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  jobs            Job[]
  users           User[]   // 1 company có nhiều users, 1 user chỉ thuộc về 1 company
  
  // Social media profiles (polymorphic relationship via ownerType + ownerId)
  
  @@index([name])
  @@index([industry])
  @@index([isActive, isVerified])
  @@index([createdAt])
}


model CV {
  id              String   @id @default(cuid())
  title           String
  isMain          Boolean  @default(false)
  
  // Personal Information
  fullName        String
  email           String
  phoneNumber     String?
  dateOfBirth     DateTime?
  gender          Gender?
  nationality     String?
  address         String?
  avatarUrl       String?
  
  
  // Current Position (like LinkedIn headline)
  currentPosition String?  // "Senior Developer at ABC Corp"
  
  // Professional Summary
  summary         String?
  objective       String?
  
  // Relationships to detailed information
  workExperience  WorkExperience[]
  education       Education[]
  languages       Language[]
  certifications  Certification[]
  projects        Project[]
  achievements    Achievement[]
  references      Reference[]
  skills          CVSkill[]
  activities      Activity[]
  applications    Application[]
  
  // Social media profiles (polymorphic relationship via ownerType + ownerId)
    
  // Metadata
  lastGeneratedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String
  embedding       Float[]
  
  // Relations (for querying, not stored in database)
  user            User     @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([isMain])
  @@index([createdAt])
}

model Job {
  id              String        @id @default(cuid())
  title           String
  description     String?
  location        String?
  industry        String?
  experienceLevel ExperienceLevel?
  type            JobType       @default(FULL_TIME)
  salary          Float?
  embedding       Float[] 
  urgent          Boolean       @default(false)  // job dang tuyen gap
  isActive        Boolean       @default(true)
  expiresAt       DateTime?
  applicationCount Int          @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  companyId       String
  
  // Relations (for querying, not stored in database)
  company         Company       @relation(fields: [companyId], references: [id])
  applications    Application[]
  savedJobs       SavedJob[]

  requirements    JobRequirement[]
  benefits        JobBenefit[]
  jobSkills       JobSkill[]
  
  @@index([companyId])
  @@index([isActive])
  @@index([type])
  @@index([createdAt])
  @@index([expiresAt])
}

model Application {
  id              String   @id @default(cuid())
  status          AppStatus @default(PENDING)
  cvId            String
  jobId           String
  coverLetter     String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations (for querying, not stored in database)
  cv              CV       @relation(fields: [cvId], references: [id])
  job             Job      @relation(fields: [jobId], references: [id])
  
  @@unique([cvId, jobId]) // Một CV chỉ có thể apply cho một Job một lần
  @@index([jobId, status])
  @@index([createdAt])
}



model SocialMedia {
  id          String   @id @default(cuid())
  platform    String   // linkedin, facebook, twitter, instagram, github, blog, website, etc.
  url         String
  
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Polymorphic relationship - simplified approach
  ownerType   String   // "User", "Company", "CV"
  ownerId     String   // ID of the owner (user, company, or cv)
  
  @@index([platform])
  @@index([ownerType, ownerId])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  
  // Relations (for querying, not stored in database)
  user      User     @relation(fields: [userId], references: [id])
  job       Job      @relation(fields: [jobId], references: [id])
  
  @@unique([userId, jobId])
  @@index([userId])
  @@index([createdAt])
}


enum UserRole {
  ADMIN
  RECRUITER
  CANDIDATE
}

enum CompanyRole {
  OWNER
  MANAGER
  RECRUITER
  VIEWER
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum AppStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// New Enums
enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum CompanySize {
  STARTUP      // 1-10
  SMALL        // 11-50
  MEDIUM       // 51-200
  LARGE        // 201-1000
  ENTERPRISE   // 1000+
}

enum UploadCategory {
  AVATAR
  LOGO
  DOCUMENT
  CV_FILE
  OTHER
}

enum ExperienceLevel {
  ENTRY        // 0-1 năm
  JUNIOR       // 1-3 năm
  MID          // 3-5 năm
  SENIOR       // 5-8 năm
  LEAD         // 8+ năm
}

enum NotificationType {
  JOB_APPLICATION
  JOB_APPROVED
  JOB_REJECTED
  INTERVIEW_SCHEDULED
  APPLICATION_STATUS_CHANGED
  NEW_JOB_MATCH
  COMPANY_VERIFIED
  SYSTEM_ANNOUNCEMENT
}

// InterviewStatus enum removed - Interview model removed

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum LanguageLevel {
  BASIC
  CONVERSATIONAL
  PROFESSIONAL
  NATIVE
}

// New Models
model Notification {
  id          String   @id @default(cuid())
  title       String
  message     String
  type        NotificationType
  isRead      Boolean  @default(false)
  data        Json?    // Dữ liệu bổ sung
  createdAt   DateTime @default(now())
  userId      String
  
  // Relations (for querying, not stored in database)
  user        User     @relation(fields: [userId], references: [id])
  
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([type])
}



model WorkExperience {
  id          String   @id @default(cuid())
  title       String   // Job title/position
  company     String
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cvId        String
  
  // Relations (for querying, not stored in database)
  cv          CV       @relation(fields: [cvId], references: [id])
  
  @@index([cvId])
}

model Education {
  id          String   @id @default(cuid())
  institution String
  degree      String
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cvId        String
  
  // Relations (for querying, not stored in database)
  cv          CV       @relation(fields: [cvId], references: [id])
  
  @@index([cvId])
}

model Language {
  id          String   @id @default(cuid())
  name        String
  level       String?  // Basic, Intermediate, Advanced, Native
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cvId        String
  
  // Relations (for querying, not stored in database)
  cv          CV       @relation(fields: [cvId], references: [id])
  
  @@index([cvId])
}

model Certification {
  id          String   @id @default(cuid())
  name        String
  issuer      String?
  acquiredAt  DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cvId        String
  
  // Relations (for querying, not stored in database)
  cv          CV       @relation(fields: [cvId], references: [id])
  
  @@index([cvId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime?
  url         String?
  role        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cvId        String
  
  // Relations (for querying, not stored in database)
  cv          CV       @relation(fields: [cvId], references: [id])
  
  @@index([cvId])
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  description String?
  acquiredAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cvId        String
  
  // Relations (for querying, not stored in database)
  cv          CV       @relation(fields: [cvId], references: [id])
  
  @@index([cvId])
}

model Reference {
  id          String   @id @default(cuid())
  name        String
  position    String?
  company     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cvId        String
  
  // Relations (for querying, not stored in database)
  cv          CV       @relation(fields: [cvId], references: [id])
  
  @@index([cvId])
}

model Activity {
  id          String   @id @default(cuid())
  title       String   // "Volunteer Work", "Open Source Contribution", "Speaking", etc.
  organization String? // Organization or event name
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cvId        String
  
  // Relations (for querying, not stored in database)
  cv          CV       @relation(fields: [cvId], references: [id])
  
  @@index([cvId])
}

model CVSkill {
  id                  String   @id @default(cuid())
  skillName           String   // "JavaScript", "React", "Python", etc.
  level               SkillLevel
  yearsOfExperience   Int?
  description         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  cvId                String
  
  // Relations (for querying, not stored in database)
  cv                  CV       @relation(fields: [cvId], references: [id])
  
  @@unique([cvId, skillName])
  @@index([cvId])
  @@index([skillName])
  @@index([level])
}

model JobRequirement {
  id          String   @id @default(cuid())
  title       String   // "Skills", "Experience", "Education", etc.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobId       String
  
  // Relations (for querying, not stored in database)
  job         Job      @relation(fields: [jobId], references: [id])
  
  @@index([jobId])
}

model JobBenefit {
  id          String   @id @default(cuid())
  title       String   // "Health Insurance", "Remote Work", "Bonus", etc.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobId       String
  
  // Relations (for querying, not stored in database)
  job         Job      @relation(fields: [jobId], references: [id])
  
  @@index([jobId])
}

model JobSkill {
  id          String   @id @default(cuid())
  skillName   String   // Direct skill name: "JavaScript", "React", "Python", etc.
  isRequired  Boolean  @default(true)
  jobId       String
  
  // Relations (for querying, not stored in database)
  job         Job      @relation(fields: [jobId], references: [id])
  
  @@unique([jobId, skillName])
  @@index([jobId])
  @@index([skillName])
}

// File uploads tracking
model Upload {
  id          String   @id @default(cuid())
  fileName    String
  originalName String
  mimeType    String
  size        Int
  path        String
  url         String   // Full URL to access the file
  title       String?  // Optional title for the file
  description String?  // Optional description
  category    UploadCategory
  uploadedBy  String?  // User ID who uploaded
  userId      String?  // Alias for uploadedBy for compatibility
  createdAt   DateTime @default(now())
  
  @@index([uploadedBy])
  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

